---
import { cv } from '../data/cv';

const contact = [
  { label: cv.phone },
  { label: cv.email, href: `mailto:${cv.email}` },
  { label: 'github.com/Dang-Duong', href: 'https://github.com/Dang-Duong' },
  { label: 'linkedin.com/in/dang-duong-nguyen', href: 'https://www.linkedin.com/in/dang-duong-nguyen/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{cv.name} — CV</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/dreampulse/computer-modern-web-font@master/font/Serif/cmun-serif.css"
    />
  </head>
  <body>
    <header>
      <h1>{cv.name}</h1>
      <p class="contact">
        {
          contact.map((c, i) => (
            <>
              {i > 0 && <span class="sep">◇</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : c.label}
            </>
          ))
        }
      </p>
    </header>

    <section>
      <h2>About me</h2>
      <p>{cv.about}</p>
    </section>

    <section>
      <h2>Experience</h2>
      {
        cv.experience.map((job) => (
          <div class="entry">
            <div class="row">
              <strong>{job.company}</strong>
              <span>{job.period}</span>
            </div>
            <div class="row">
              <em>{job.role}</em>
              <em>{job.type}</em>
            </div>
            <ul>
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Education</h2>
      {
        cv.education.map((e) => (
          <div class="entry">
            <div class="row">
              <strong>{e.school}</strong>
              <span>{e.period}</span>
            </div>
            <p>{e.degree}</p>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {
          cv.skills.map((s) => (
            <>
              <dt>{s.group}:</dt>
              <dd>{s.items.join(', ')}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section>
      <h2>Projects</h2>
      <p>{cv.projectsNote}</p>
    </section>

    <section>
      <h2>Languages</h2>
      <p>{cv.languages.join(' • ')}</p>
    </section>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 10mm 14mm;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    font: 9.5pt/1.27 'Computer Modern Serif', 'Latin Modern Roman', Georgia, serif;
    color: #000;
    background: #fff;
    max-width: 180mm;
    margin: 0 auto;
    padding: 16px;
  }
  @media print {
    body {
      padding: 0;
    }
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  header {
    text-align: center;
    margin-bottom: 8px;
  }
  h1 {
    font-size: 21pt;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .contact {
    margin-top: 3px;
  }
  .sep {
    margin: 0 5px;
    font-size: 8pt;
  }
  section {
    margin-top: 7px;
  }
  h2 {
    font-size: 10.5pt;
    font-weight: bold;
    text-transform: uppercase;
    border-bottom: 0.8px solid #000;
    padding-bottom: 1px;
    margin-bottom: 4px;
  }
  section > p,
  .entry,
  .skills {
    padding-left: 14pt;
  }
  .entry + .entry {
    margin-top: 5px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .row span,
  .row em:last-child {
    white-space: nowrap;
  }
  ul {
    list-style: none;
    margin-top: 1px;
  }
  li {
    padding-left: 9pt;
    text-indent: -9pt;
  }
  li::before {
    content: '- ';
  }
  .skills {
    display: grid;
    grid-template-columns: 105pt 1fr;
    column-gap: 8pt;
  }
  dt {
    font-weight: bold;
  }
</style>
