---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${cv.name} — ${cv.title}`} description={cv.intro}>
  <script is:inline slot="head">
    history.scrollRestoration = 'manual';
    (function () {
      var nav = performance.getEntriesByType('navigation')[0];
      var reload = nav && nav.type === 'reload';
      if (reload && location.hash) history.replaceState(null, '', location.pathname + location.search);
      var toTop = function () {
        if (!location.hash) scrollTo(0, 0);
      };
      toTop();
      addEventListener('load', function () {
        requestAnimationFrame(toTop);
      });
      addEventListener('pageshow', function (e) {
        if (e.persisted) toTop();
      });
    })();
  </script>

  <header class="wrap top">
    <span class="label"><i class="dot"></i>Live · Bib #0973</span>
    <span class="label clock" id="clock">Prague --:--:--</span>
    <a href="#contact" class="label">Contact</a>
  </header>

  <main class="hero">
    <p class="label kicker">Swim <span>·</span> Bike <span>·</span> Run <span>·</span> Ship</p>
    <div id="particles" aria-hidden="true"></div>
    <h1>Nguyen Dang <span class="accent">Duong</span></h1>
    <div class="wrap meta">
      <p class="lede">
        Software engineer in Prague — AI, web &amp; mobile.<br />
        <em>Training for my first Ironman.</em>
      </p>
    </div>
    <span class="label hint">Hover to scatter · click to switch</span>
  </main>

  <footer class="wrap" id="contact">
    <p class="label">Race complete · Journey ongoing</p>
    <h2>There is no <em class="accent">finish line.</em></h2>
    <p class="creed">Every race ends. Getting better never does — in code, in sport, in life.</p>
    <a class="email" href={`mailto:${cv.email}`}>{cv.email}</a>
    <ul class="links">
      {
        cv.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          </li>
        ))
      }
      <li><a href={`${base}cv.pdf`} target="_blank" class="cta">Download CV (PDF) ↓</a></li>
    </ul>
    <p class="label copy">© {new Date().getFullYear()} {cv.name}</p>
  </footer>
</Base>

<script>
  import { mountParticles } from '../scripts/particles';

  mountParticles(document.getElementById('particles')!);

  const clock = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Prague',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
  const tick = () => (clock.textContent = `Prague ${fmt.format(new Date())}`);
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px max(16px, calc((100vw - 1100px) / 2 + 16px));
    z-index: 10;
    background: linear-gradient(var(--bg) 40%, transparent);
  }
  .top .label {
    color: var(--fg);
  }
  .top a {
    text-decoration: none;
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    margin-right: 8px;
    vertical-align: 1px;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 76px 0 28px;
    overflow: hidden;
  }
  .kicker span {
    color: var(--accent);
    margin: 0 6px;
  }
  #particles {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 300px;
    cursor: pointer;
  }
  #particles :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  h1 {
    font-size: clamp(52px, 10.5vw, 176px);
    text-align: center;
    margin-top: -0.35em;
    position: relative;
    pointer-events: none;
    padding: 0 16px;
  }
  .meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--fg);
  }
  .lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.45;
  }
  .lede em,
  footer em {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15em;
    font-weight: 400;
  }
  .cta {
    background: var(--accent);
    color: #fff;
    border-radius: 99px;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .cta:hover {
    transform: translateY(-2px);
  }
  .hint {
    position: absolute;
    right: 16px;
    top: 50%;
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  footer {
    padding-top: 120px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
  }
  footer h2 {
    font-size: clamp(48px, 8vw, 120px);
    margin: 16px 0 16px;
  }
  footer h2 em {
    text-transform: none;
    font-size: 1.05em;
  }
  .creed {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 48px;
  }
  .email {
    font: 600 clamp(22px, 4vw, 40px) var(--display);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    word-break: break-all;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
    font-size: 18px;
  }
  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .links a:hover {
    border-color: var(--accent);
  }
  .links .cta {
    font: 800 20px var(--display);
    text-transform: uppercase;
    padding: 12px 24px;
    border: 0;
  }
  .copy {
    margin-top: 96px;
  }

  @media (max-width: 900px) {
    .clock,
    .hint {
      display: none;
    }
    h1 {
      font-size: clamp(44px, 15vw, 88px);
      line-height: 0.9;
    }
    .meta {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
