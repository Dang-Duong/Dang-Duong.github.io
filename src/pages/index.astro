---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const lanes = [1, 2, 3, 4, 5, 6, 7, 8];
---

<Base title={`${cv.name} — ${cv.title}`} description={cv.intro}>
  <header class="wrap top">
    <div>
      <strong>{cv.name}</strong>
      <span class="label">{cv.title}, {cv.location}</span>
    </div>
    <span class="label clock" id="clock">Prague --:--:--</span>
    <a href="#contact" class="label">Contact</a>
  </header>

  <main class="hero">
    <ol class="lanes" aria-hidden="true">
      {lanes.map((n) => <li><span class="label">{n}</span></li>)}
    </ol>
    <div class="wrap hero-copy">
      <p class="label"><span class="accent">●</span> Swim · Bike · Run · Ship</p>
      <h1>Built for the<br /><span class="accent">long</span> distance.</h1>
      <p class="intro">{cv.intro}</p>
    </div>
    <div id="playground" aria-hidden="true">
      <span class="label hint">Grab · Throw<span class="more"> · Double-click for more</span></span>
    </div>
  </main>

  <footer class="wrap" id="contact">
    <p class="label"><b class="accent">FIN</b> — Finish line</p>
    <h2>Get in <span class="accent">contact</span></h2>
    <a class="email" href={`mailto:${cv.email}`}>{cv.email}</a>
    <ul class="links">
      {
        cv.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          </li>
        ))
      }
      <li><a href={`${base}cv.pdf`} target="_blank" class="cta">Download CV (PDF) ↓</a></li>
    </ul>
    <p class="label copy">© {new Date().getFullYear()} {cv.name}</p>
  </footer>
</Base>

<script>
  import { mountBalls } from '../scripts/balls';

  mountBalls(document.getElementById('playground')!);

  const el = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Prague',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
  const tick = () => (el.textContent = `Prague ${fmt.format(new Date())}`);
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .top {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
    z-index: 3;
  }
  .top div {
    display: flex;
    flex-direction: column;
  }
  .top strong {
    font: 800 20px var(--display);
    text-transform: uppercase;
  }
  .top a {
    text-decoration: none;
    color: var(--fg);
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }

  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .lanes {
    position: absolute;
    inset: 0;
    list-style: none;
    display: grid;
    grid-template-rows: repeat(8, 1fr);
  }
  .lanes li {
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-right: 16px;
  }
  .lanes span {
    opacity: 0.5;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
    user-select: none;
  }
  .hero h1 {
    font-size: clamp(60px, 11vw, 168px);
    margin: 16px 0 24px;
  }
  .intro {
    font-size: clamp(16px, 1.8vw, 20px);
    color: var(--muted);
    max-width: 520px;
  }

  #playground {
    position: absolute;
    inset: 0;
    z-index: 2;
    touch-action: pan-y;
  }
  #playground :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
  #playground:global(.over-ball) {
    cursor: grab;
  }
  #playground:global(.grabbing) {
    cursor: grabbing;
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    border: 1px solid var(--line);
    background: var(--bg);
    padding: 6px 14px;
    border-radius: 99px;
    white-space: nowrap;
    pointer-events: none;
  }

  footer {
    padding-top: 120px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
  }
  footer h2 {
    font-size: clamp(56px, 10vw, 150px);
    margin: 16px 0 32px;
  }
  .email {
    font: 600 clamp(22px, 4vw, 40px) var(--display);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    word-break: break-all;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
    font-size: 18px;
  }
  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .links a:hover {
    border-color: var(--accent);
  }
  .links .cta {
    background: var(--accent);
    color: var(--bg);
    font: 800 20px var(--display);
    text-transform: uppercase;
    padding: 12px 24px;
    border-radius: 99px;
    border: 0;
    transition: transform 0.2s;
  }
  .links .cta:hover {
    transform: translateY(-2px);
  }
  .copy {
    margin-top: 96px;
  }

  @media (max-width: 767px) {
    .clock,
    .lanes span {
      display: none;
    }
    .hero {
      align-items: flex-start;
      padding-top: 120px;
    }
  }
  @media (hover: none) {
    .more {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hint {
      display: none;
    }
  }
</style>
