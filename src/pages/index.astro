---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${cv.name} — ${cv.title}`} description={cv.intro}>
  <script is:inline slot="head">
    history.scrollRestoration = 'manual';
    (function () {
      var nav = performance.getEntriesByType('navigation')[0];
      var reload = nav && nav.type === 'reload';
      if (reload && location.hash) history.replaceState(null, '', location.pathname + location.search);
      var toTop = function () {
        if (!location.hash) scrollTo(0, 0);
      };
      toTop();
      addEventListener('load', function () {
        requestAnimationFrame(toTop);
      });
      addEventListener('pageshow', function (e) {
        if (e.persisted) toTop();
      });
    })();
  </script>
  <header class="wrap top">
    <div class="athlete">
      <span class="live label"><i></i>Live</span>
      <span class="label">Bib #0973 · {cv.title}<span class="loc">, {cv.location}</span></span>
    </div>
    <span class="label clock" id="clock">Prague --:--:--</span>
    <a href="#contact" class="label">Contact</a>
  </header>

  <main class="hero">
    <div id="particles" aria-hidden="true">
      <span class="label hint">Move through the particles · click to switch</span>
    </div>
    <div class="wrap intro">
      <p class="label"><span class="accent">●</span> Swim · Bike · Run · Ship</p>
      <h1>Nguyen Dang<br /><span class="accent">Duong</span></h1>
      <p class="lede">Software engineer in Prague. AI, web &amp; mobile. Training for my first Ironman.</p>
    </div>
  </main>

  <footer class="wrap" id="contact">
    <p class="label"><span class="accent">●</span> Race complete · Journey ongoing</p>
    <h2>There is no<br /><span class="accent">finish line.</span></h2>
    <p class="creed">Every race ends. Getting better never does — in code, in sport, in life.</p>
    <a class="email" href={`mailto:${cv.email}`}>{cv.email}</a>
    <ul class="links">
      {
        cv.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          </li>
        ))
      }
      <li><a href={`${base}cv.pdf`} target="_blank" class="cta">Download CV (PDF) ↓</a></li>
    </ul>
    <p class="label copy">© {new Date().getFullYear()} {cv.name}</p>
  </footer>
</Base>

<script>
  import { mountParticles } from '../scripts/particles';

  mountParticles(document.getElementById('particles')!);

  const clock = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Prague',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
  const tick = () => (clock.textContent = `Prague ${fmt.format(new Date())}`);
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px max(16px, calc((100vw - 1100px) / 2 + 16px));
    z-index: 10;
    background: linear-gradient(var(--bg) 30%, transparent);
  }
  .athlete {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .top a {
    text-decoration: none;
    color: var(--fg);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--bg);
    background: var(--accent);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff3b30;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }

  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(ellipse at 65% 50%, #14171b 0%, var(--bg) 70%);
  }
  #particles {
    position: absolute;
    inset: 0 0 0 38%;
    cursor: pointer;
  }
  #particles :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hint {
    position: absolute;
    right: 16px;
    bottom: 16px;
    opacity: 0.7;
    pointer-events: none;
  }
  .intro {
    position: relative;
    width: 100%;
    pointer-events: none;
  }
  .intro h1 {
    font-size: clamp(56px, 9vw, 140px);
    margin: 16px 0 24px;
    max-width: 8ch;
  }
  .lede {
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--muted);
    max-width: 440px;
  }

  footer {
    padding-top: 120px;
    padding-bottom: 40px;
  }
  footer h2 {
    font-size: clamp(48px, 8vw, 120px);
    margin: 16px 0 16px;
  }
  .creed {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 48px;
  }
  .email {
    font: 600 clamp(22px, 4vw, 40px) var(--display);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    word-break: break-all;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
    font-size: 18px;
  }
  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .links a:hover {
    border-color: var(--accent);
  }
  .links .cta {
    background: var(--accent);
    color: var(--bg);
    font: 800 20px var(--display);
    text-transform: uppercase;
    padding: 12px 24px;
    border-radius: 99px;
    border: 0;
    transition: transform 0.2s;
  }
  .links .cta:hover {
    transform: translateY(-2px);
  }
  .copy {
    margin-top: 96px;
  }

  @media (max-width: 900px) {
    .clock,
    .loc,
    .hint {
      display: none;
    }
    .hero {
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: 40px;
    }
    #particles {
      inset: 64px 0 auto 0;
      height: 52svh;
    }
  }
</style>
