---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const stories = [
  { leg: 'Swim', km: '3.8 km', title: 'Learning to breathe', text: '2023–24 · Informatics at VŠE, then Software Development at Unicorn University.' },
  { leg: 'Bike', km: '180 km', title: 'Building speed', text: '2025 · Founding engineer at Hostivio & Pultio — AI ID scanning, an iOS app, Stripe payouts.' },
  { leg: 'Run', km: '42.2 km', title: 'Going the distance', text: '2025–26 · Yolk Studio — 1,500+ PRs across fintech, AI and mobile products.' },
];
---

<Base title={`${cv.name} — ${cv.title}`} description={cv.intro}>
  <header class="wrap top">
    <div class="athlete">
      <span class="live label"><i></i>Live</span>
      <div>
        <strong>{cv.name}</strong>
        <span class="label">Bib #0973 · {cv.title}<span class="loc">, {cv.location}</span></span>
      </div>
    </div>
    <span class="label clock" id="clock">Prague --:--:--</span>
    <a href="#contact" class="label">Contact</a>
  </header>

  <main id="track" class="track">
    <div class="stage" id="stage" data-phase="intro">
      <div id="course" aria-hidden="true"></div>

      <div class="wrap intro">
        <p class="label"><span class="accent">●</span> Live tracking · Athlete #0973</p>
        <h1>Built for the<br /><span class="accent">long</span> distance.</h1>
        <p class="lede">{cv.intro}</p>
        <p class="label cue">Scroll to start the race <span class="accent">↓</span></p>
      </div>

      <div class="countdown" id="countdown" aria-hidden="true"></div>

      <div class="wrap hud" aria-hidden="true">
        <div class="leg">
          <span class="label" id="leg-no">Leg 1/3</span>
          <b id="leg-name">Swim</b>
        </div>
        <dl class="metrics">
          <div><dt class="label">Distance</dt><dd><span id="km">0.0</span><small>/ 226 km</small></dd></div>
          <div><dt class="label">Speed</dt><dd><span id="speed">0.0</span><small>km/h</small></dd></div>
          <div><dt class="label">Elevation</dt><dd><span id="elev">0</span><small>m</small></dd></div>
          <div class="hr"><dt class="label">Heart rate</dt><dd><span id="bpm">72</span><small>bpm</small></dd><canvas id="ecg"></canvas></div>
        </dl>
        <div class="bar">
          <span style="--c:#3ad7ff;--w:20"><i id="bar-0"></i></span>
          <span style="--c:#d4ff3a;--w:28"><i id="bar-1"></i></span>
          <span style="--c:#ff6a3d;--w:24"><i id="bar-2"></i></span>
        </div>
      </div>

      <div class="wrap stories">
        {
          stories.map((s, i) => (
            <article class="story" data-leg={i}>
              <p class="label">
                <span class="accent">{s.leg}</span> · {s.km}
              </p>
              <h2>{s.title}</h2>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>

      <div class="wrap results">
        <p class="label"><span class="accent">●</span> Official result · Finisher</p>
        <h2>Finish line. <span class="accent">BSc 2026.</span></h2>
        <div class="tiles">
          <div class="tile">
            <p class="label">Race time</p>
            <p class="val mono" id="elapsed">—</p>
            <p class="label sub">Since first pro commit</p>
          </div>
          <div class="tile">
            <p class="label">PRs merged</p>
            <p class="val">1,500+</p>
            <p class="label sub">Web · Mobile · Backend</p>
          </div>
          <div class="tile">
            <p class="label">Products shipped</p>
            <p class="val">10+</p>
            <p class="label sub">Fintech · SaaS · AI</p>
          </div>
          <div class="tile">
            <p class="label">Next race</p>
            <p class="val accent">Your team?</p>
            <p class="label sub">Keep scrolling ↓</p>
          </div>
        </div>
      </div>

      <span class="label hint">Drag to look around</span>
    </div>
  </main>

  <footer class="wrap" id="contact">
    <p class="label"><b class="accent">FIN</b> — After the finish line</p>
    <h2>Get in <span class="accent">contact</span></h2>
    <a class="email" href={`mailto:${cv.email}`}>{cv.email}</a>
    <ul class="links">
      {
        cv.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          </li>
        ))
      }
      <li><a href={`${base}cv.pdf`} target="_blank" class="cta">Download CV (PDF) ↓</a></li>
    </ul>
    <p class="label copy">© {new Date().getFullYear()} {cv.name}</p>
  </footer>
</Base>

<script>
  import { mountRace, LEGS, START } from '../scripts/race';
  import { mountHeartRate, mountRaceTime } from '../scripts/hud';

  const $ = (id: string) => document.getElementById(id)!;
  const stage = $('stage');
  const stories = [...document.querySelectorAll<HTMLElement>('.story')];
  let bpm = 72;

  mountRaceTime($('elapsed'));
  mountHeartRate($('ecg') as HTMLCanvasElement, () => bpm);
  mountRace($('course'), $('track'), (s) => {
    bpm = s.bpm;
    const phase = s.leg < 0 ? (s.p < START - 0.08 ? 'intro' : 'start') : s.leg >= LEGS.length ? 'finish' : 'race';
    if (stage.dataset.phase !== phase) stage.dataset.phase = phase;

    const n = Math.floor((s.p - (START - 0.08)) / 0.02);
    $('countdown').textContent = phase === 'start' && n >= 0 ? (['3', '2', '1', 'GO'][n] ?? '') : '';

    const leg = Math.min(Math.max(s.leg, 0), LEGS.length - 1);
    $('leg-no').textContent = `Leg ${leg + 1}/${LEGS.length}`;
    $('leg-name').textContent = LEGS[leg].name;
    $('leg-name').style.color = LEGS[leg].color;
    $('km').textContent = s.km.toFixed(1);
    $('speed').textContent = s.speed.toFixed(1);
    $('elev').textContent = String(Math.round(s.elevation));
    $('bpm').textContent = String(Math.round(s.bpm));
    LEGS.forEach((_, j) => {
      const f = j < s.leg ? 1 : j === s.leg ? s.legFrac : 0;
      $(`bar-${j}`).style.transform = `scaleX(${f})`;
    });
    stories.forEach((el, j) => el.classList.toggle('on', j === s.leg));
  });

  const clock = $('clock');
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Prague',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
  const tick = () => (clock.textContent = `Prague ${fmt.format(new Date())}`);
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px max(16px, calc((100vw - 1100px) / 2 + 16px));
    z-index: 10;
    background: linear-gradient(var(--bg) 30%, transparent);
  }
  .athlete {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .athlete div {
    display: flex;
    flex-direction: column;
  }
  .top strong {
    font: 800 20px var(--display);
    text-transform: uppercase;
  }
  .top a {
    text-decoration: none;
    color: var(--fg);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--bg);
    background: var(--accent);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff3b30;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }

  .track {
    height: 800vh;
    position: relative;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: radial-gradient(ellipse at 60% 50%, #14171b 0%, var(--bg) 70%);
  }
  #course {
    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: pan-y;
  }
  #course:active {
    cursor: grabbing;
  }
  #course :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
  #course :global(.course-labels) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  #course :global(.course-tag) {
    font: 500 11px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    background: rgba(11, 12, 14, 0.8);
    border: 1px solid var(--line);
    border-left: 3px solid var(--c);
    padding: 3px 8px;
    white-space: nowrap;
  }
  #course :global(.course-tag b) {
    color: var(--c);
    font-weight: 500;
  }

  .intro,
  .hud,
  .stories,
  .results,
  .countdown {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    transition:
      opacity 0.5s,
      transform 0.5s;
  }
  .intro {
    top: 50%;
    transform: translateY(-50%);
  }
  .intro h1 {
    font-size: clamp(56px, 9vw, 140px);
    margin: 16px 0 24px;
    max-width: 8ch;
  }
  .lede {
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--muted);
    max-width: 440px;
  }
  .cue {
    margin-top: 32px;
    animation: nudge 1.6s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(6px);
    }
  }
  [data-phase]:not([data-phase='intro']) .intro {
    opacity: 0;
    transform: translateY(-60%);
  }

  .countdown {
    top: 50%;
    transform: translateY(-50%);
    text-align: center;
    font: 800 clamp(120px, 26vw, 360px) / 1 var(--display);
    color: var(--accent);
    text-shadow: 0 0 60px rgba(212, 255, 58, 0.35);
  }

  .hud {
    top: 88px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px 32px;
    align-items: end;
    opacity: 0;
    transform: translateY(-12px);
  }
  [data-phase='race'] .hud {
    opacity: 1;
    transform: none;
  }
  .leg b {
    display: block;
    font: 800 clamp(40px, 6vw, 72px) / 0.9 var(--display);
    text-transform: uppercase;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .metrics > div {
    border: 1px solid var(--line);
    background: rgba(17, 19, 22, 0.75);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 10px 14px;
    position: relative;
    overflow: hidden;
  }
  .metrics dd {
    font: 800 clamp(22px, 2.6vw, 34px) / 1.1 var(--display);
    font-variant-numeric: tabular-nums;
  }
  .metrics small,
  .val small {
    font: 500 11px var(--mono);
    color: var(--muted);
    margin-left: 6px;
  }
  #ecg {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 55%;
    height: 55%;
  }
  .bar {
    grid-column: 1 / -1;
    display: flex;
    gap: 4px;
  }
  .bar span {
    flex: var(--w);
    height: 4px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--c);
    transform: scaleX(0);
    transform-origin: left;
  }

  .stories {
    bottom: 48px;
  }
  .story {
    position: absolute;
    bottom: 0;
    max-width: 440px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    background: rgba(11, 12, 14, 0.82);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.45s,
      transform 0.45s;
  }
  .story.on {
    opacity: 1;
    transform: none;
  }
  .story h2 {
    font-size: clamp(32px, 4vw, 48px);
    margin: 8px 0 10px;
  }
  .story p:last-child {
    color: var(--muted);
  }

  .results {
    bottom: 48px;
    opacity: 0;
    transform: translateY(24px);
  }
  [data-phase='finish'] .results {
    opacity: 1;
    transform: none;
  }
  .results h2 {
    font-size: clamp(44px, 7vw, 104px);
    margin: 12px 0 24px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .tile {
    border: 1px solid var(--line);
    background: rgba(17, 19, 22, 0.78);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 14px 16px;
  }
  .val {
    font: 800 clamp(26px, 3vw, 40px) / 1.1 var(--display);
    margin: 4px 0 2px;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }
  .val.mono {
    font: 500 clamp(18px, 2vw, 26px) / 1.5 var(--mono);
  }
  .sub {
    font-size: 10px;
  }

  .hint {
    position: absolute;
    right: 16px;
    bottom: 16px;
    opacity: 0.7;
    pointer-events: none;
  }

  footer {
    padding-top: 120px;
    padding-bottom: 40px;
  }
  footer h2 {
    font-size: clamp(56px, 10vw, 150px);
    margin: 16px 0 32px;
  }
  .email {
    font: 600 clamp(22px, 4vw, 40px) var(--display);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    word-break: break-all;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
    font-size: 18px;
  }
  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .links a:hover {
    border-color: var(--accent);
  }
  .links .cta {
    background: var(--accent);
    color: var(--bg);
    font: 800 20px var(--display);
    text-transform: uppercase;
    padding: 12px 24px;
    border-radius: 99px;
    border: 0;
    transition: transform 0.2s;
  }
  .links .cta:hover {
    transform: translateY(-2px);
  }
  .copy {
    margin-top: 96px;
  }

  @media (max-width: 900px) {
    .clock,
    .loc,
    .hint {
      display: none;
    }
    .intro {
      top: auto;
      bottom: 32px;
      transform: none;
    }
    [data-phase]:not([data-phase='intro']) .intro {
      transform: translateY(-8%);
    }
    .intro h1 {
      margin: 12px 0 16px;
    }
    .cue {
      margin-top: 20px;
    }
    .hud {
      top: 76px;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stories {
      bottom: 24px;
    }
    .story {
      left: 16px;
      right: 16px;
      max-width: none;
      padding: 14px 16px;
    }
    .results {
      bottom: 24px;
    }
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
