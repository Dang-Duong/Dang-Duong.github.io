---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${cv.name} — ${cv.title}`} description={cv.intro}>
  <script is:inline slot="head">
    history.scrollRestoration = 'manual';
    (function () {
      var nav = performance.getEntriesByType('navigation')[0];
      var reload = nav && nav.type === 'reload';
      if (reload && location.hash) history.replaceState(null, '', location.pathname + location.search);
      var toTop = function () {
        if (!location.hash) scrollTo({ top: 0, behavior: 'instant' });
      };
      toTop();
      addEventListener('load', function () {
        requestAnimationFrame(toTop);
      });
      addEventListener('pageshow', function (e) {
        if (e.persisted) toTop();
      });
    })();
  </script>

  <header class="wrap top">
    <a href="#contact" class="label now"><i class="dot"></i>Open to new projects<span class="more"> — hit me up</span></a>
    <span class="label clock" id="clock">Prague --:--:--</span>
    <nav class="actions">
      <button class="label theme" id="theme" type="button" aria-label="Toggle dark mode">Dark</button>
      <a href="#contact" class="label">Contact</a>
    </nav>
  </header>

  <div id="particles" aria-hidden="true"></div>

  <main class="hero" id="hero">
    <p class="label kicker">Swim <span>·</span> Bike <span>·</span> Run <span>·</span> Ship</p>
    <div class="stage"></div>
    <h1><span class="split a">Nguyen Dang</span> <span class="split b accent">Duong</span></h1>
    <div class="wrap meta">
      <p class="lede">
        Software engineer in Prague — AI, web &amp; mobile.<br />
        <em>Training for my first Ironman.</em>
      </p>
    </div>
    <span class="label hint">Hover to scatter · click to morph</span>
  </main>

  <footer class="panel" id="contact">
    <div class="wrap">
    <p class="label">Race complete · Journey ongoing</p>
    <h2><span class="line"><span>There is no</span></span><span class="line"><em>finish line.</em></span></h2>
    <p class="creed">Every race ends. Getting better never does — in code, in sport, in life.</p>
    <p class="talk">Got a project or a role in mind? <em class="accent">Contact me.</em></p>
    <a class="email" href={`mailto:${cv.email}`}>{cv.email}</a>
    <ul class="links">
      {
        cv.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href={`${base}cv.pdf`} target="_blank" class="cta">Download CV (PDF)</a></li>
    </ul>
    <p class="label copy">© {new Date().getFullYear()} {cv.name}</p>
    </div>
  </footer>
</Base>

<script>
  import { mountParticles } from '../scripts/particles';
  import { mountCursor } from '../scripts/cursor';

  const hero = document.getElementById('hero')!;
  const panel = document.getElementById('contact')!;
  const splitA = document.querySelector<HTMLElement>('.split.a')!;
  const splitB = document.querySelector<HTMLElement>('.split.b')!;
  const fades = [...document.querySelectorAll<HTMLElement>('.meta, .kicker')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const header = document.querySelector<HTMLElement>('.top')!;
  let headerMid = header.offsetHeight / 2;
  new ResizeObserver(() => (headerMid = header.offsetHeight / 2)).observe(header);
  let shown = -1;
  const onProgress = (p: number, panelTop: number) => {
    header.classList.toggle('on-panel', panelTop < headerMid);
    if (Math.abs(p - shown) < 0.001) return;
    shown = p;
    if (!still) {
      splitA.style.transform = `translate3d(${-22 * p}vw, 0, 0)`;
      splitB.style.transform = `translate3d(${22 * p}vw, 0, 0)`;
    }
    for (const el of fades) el.style.opacity = String(Math.max(0, 1 - p * 1.4));
  };
  mountParticles(document.getElementById('particles')!, hero, panel, onProgress);
  mountCursor(hero);

  let glide = 0;
  const cancelGlide = () => cancelAnimationFrame(glide);
  addEventListener('wheel', cancelGlide, { passive: true });
  addEventListener('touchstart', cancelGlide, { passive: true });
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) =>
    link.addEventListener('click', (e) => {
      const target = document.querySelector(link.hash);
      if (!target) return;
      e.preventDefault();
      const start = scrollY;
      const end = target.getBoundingClientRect().top + scrollY;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return scrollTo({ top: end, behavior: 'instant' });
      const duration = Math.min(1600, Math.max(800, Math.abs(end - start) * 0.9));
      const t0 = performance.now();
      cancelGlide();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / duration);
        const k = t < 0.5 ? 8 * t ** 4 : 1 - (-2 * t + 2) ** 4 / 2;
        scrollTo({ top: start + (end - start) * k, behavior: 'instant' });
        if (t < 1) glide = requestAnimationFrame(step);
      };
      glide = requestAnimationFrame(step);
    }),
  );

  new IntersectionObserver(([e]) => e.isIntersecting && panel.classList.add('in'), { threshold: 0.35 }).observe(panel);

  const root = document.documentElement;
  const themeBtn = document.getElementById('theme')!;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  const label = () => (themeBtn.textContent = isDark() ? 'Light' : 'Dark');
  label();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
  const applyTheme = () => {
    root.dataset.theme = isDark() ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    label();
  };
  themeBtn.addEventListener('click', applyTheme);

  const clock = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Prague',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
  const tick = () => (clock.textContent = `Prague ${fmt.format(new Date())}`);
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px max(16px, calc((100vw - 1100px) / 2 + 16px));
    z-index: 10;
    color: var(--fg);
    transition: color 0.25s;
  }
  .top.on-panel {
    color: var(--bg);
  }
  .top .label {
    color: inherit;
  }
  .top a {
    text-decoration: none;
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    margin-right: 8px;
    vertical-align: 1px;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }
  .actions {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .theme {
    background: none;
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    border-radius: 99px;
    padding: 4px 10px;
    color: inherit;
    cursor: pointer;
  }
  .theme:hover {
    border-color: currentColor;
  }

  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 76px 0 28px;
    overflow: hidden;
    cursor: pointer;
  }
  .kicker span {
    color: var(--accent);
    margin: 0 6px;
  }
  #particles {
    position: fixed;
    inset: 0 0 auto 0;
    height: 100vh;
    height: 100lvh;
    z-index: 5;
    pointer-events: none;
  }
  #particles :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .stage {
    flex: 1;
    min-height: 260px;
  }
  .split {
    display: inline-block;
    will-change: transform;
  }
  h1 {
    font-size: clamp(52px, 10.5vw, 176px);
    text-align: center;
    margin-top: -0.35em;
    position: relative;
    pointer-events: none;
    padding: 0 16px;
  }
  .meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--fg);
  }
  .lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.45;
  }
  .lede em,
  footer em {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15em;
    font-weight: 400;
  }
  .cta {
    background: var(--accent);
    color: #fff;
    border-radius: 99px;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .cta:hover {
    transform: translateY(-2px);
  }
  .hint {
    position: absolute;
    right: 16px;
    top: 50%;
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  footer {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100lvh;
    display: flex;
    align-items: flex-end;
    padding-top: 140px;
    padding-bottom: 40px;
    background: var(--fg);
    color: var(--bg);
    border-radius: 36px 36px 0 0;
    --muted: color-mix(in srgb, var(--bg) 60%, var(--fg));
    --line: color-mix(in srgb, var(--bg) 22%, var(--fg));
  }
  footer .wrap {
    width: 100%;
  }
  footer h2 {
    font-size: clamp(48px, 8vw, 120px);
    margin: 16px 0 16px;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .line > * {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .line + .line > * {
    transition-delay: 0.12s;
  }
  .in .line > * {
    transform: none;
  }
  footer h2 em {
    color: var(--accent);
  }
  footer h2 em {
    text-transform: none;
    font-size: 1.05em;
  }
  .creed {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 48px;
  }
  .talk {
    font: 600 clamp(22px, 2.6vw, 34px) / 1.2 var(--display);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .talk em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    font-size: 1.1em;
  }
  .email {
    font: 600 clamp(22px, 4vw, 40px) var(--display);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    word-break: break-all;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
    font-size: 18px;
  }
  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .links a:hover {
    border-color: var(--accent);
  }
  .links .cta {
    font: 800 20px var(--display);
    text-transform: uppercase;
    padding: 12px 24px;
    border: 0;
  }
  .copy {
    margin-top: 96px;
  }

  @media (prefers-reduced-motion: reduce) {
    .line > * {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    footer {
      padding-top: 42svh;
    }
    .clock,
    .hint,
    .more {
      display: none;
    }
    h1 {
      font-size: clamp(44px, 15vw, 88px);
      line-height: 0.9;
    }
    .meta {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
