---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${cv.name} — ${cv.title}`} description={cv.intro}>
  <script is:inline slot="head">
    history.scrollRestoration = 'manual';
    (function () {
      var nav = performance.getEntriesByType('navigation')[0];
      var reload = nav && nav.type === 'reload';
      if (reload && location.hash) history.replaceState(null, '', location.pathname + location.search);
      var toTop = function () {
        if (!location.hash) scrollTo(0, 0);
      };
      toTop();
      addEventListener('load', function () {
        requestAnimationFrame(toTop);
      });
      addEventListener('pageshow', function (e) {
        if (e.persisted) toTop();
      });
    })();
  </script>

  <header class="wrap top">
    <a href="#contact" class="label now"><i class="dot"></i>Open to new projects<span class="more"> — hit me up</span></a>
    <span class="label clock" id="clock">Prague --:--:--</span>
    <nav class="actions">
      <button class="label theme" id="theme" type="button" aria-label="Toggle dark mode">Dark</button>
      <a href="#contact" class="label">Contact</a>
    </nav>
  </header>

  <div id="particles" aria-hidden="true"></div>

  <main class="hero" id="hero">
    <p class="label kicker">Swim <span>·</span> Bike <span>·</span> Run <span>·</span> Ship</p>
    <div class="stage"></div>
    <h1><span class="split a">Nguyen Dang</span> <span class="split b accent">Duong</span></h1>
    <div class="wrap meta">
      <p class="lede">
        Software engineer in Prague — AI, web &amp; mobile.<br />
        <em>Training for my first Ironman.</em>
      </p>
    </div>
    <span class="label hint">Hover to scatter · click to morph</span>
  </main>

  <footer class="panel" id="contact">
    <div class="wrap">
    <p class="label">Race complete · Journey ongoing</p>
    <h2><span class="line"><span>There is no</span></span><span class="line"><em>finish line.</em></span></h2>
    <p class="creed">Every race ends. Getting better never does — in code, in sport, in life.</p>
    <a class="email" href={`mailto:${cv.email}`}>{cv.email}</a>
    <ul class="links">
      {
        cv.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href={`${base}cv.pdf`} target="_blank" class="cta">Download CV (PDF)</a></li>
    </ul>
    <p class="label copy">© {new Date().getFullYear()} {cv.name}</p>
    </div>
  </footer>
</Base>

<script>
  import { mountParticles } from '../scripts/particles';

  const hero = document.getElementById('hero')!;
  const panel = document.getElementById('contact')!;
  mountParticles(document.getElementById('particles')!, hero, panel);

  const onScroll = () => {
    const p = Math.min(1, Math.max(0, 1 - panel.getBoundingClientRect().top / innerHeight));
    document.documentElement.style.setProperty('--p', p.toFixed(4));
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  onScroll();
  new IntersectionObserver(([e]) => e.isIntersecting && panel.classList.add('in'), { threshold: 0.35 }).observe(panel);

  const root = document.documentElement;
  const themeBtn = document.getElementById('theme')!;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  const label = () => (themeBtn.textContent = isDark() ? 'Light' : 'Dark');
  label();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
  const applyTheme = () => {
    root.dataset.theme = isDark() ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    label();
  };
  themeBtn.addEventListener('click', () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return applyTheme();
    if (!document.startViewTransition) {
      root.classList.add('theme-fade');
      applyTheme();
      setTimeout(() => root.classList.remove('theme-fade'), 500);
      return;
    }
    const r = themeBtn.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    document.startViewTransition(applyTheme).ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 650, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  });

  const clock = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Prague',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
  const tick = () => (clock.textContent = `Prague ${fmt.format(new Date())}`);
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px max(16px, calc((100vw - 1100px) / 2 + 16px));
    z-index: 10;
    color: #fff;
    mix-blend-mode: difference;
  }
  .top .label {
    color: #fff;
  }
  .top a {
    text-decoration: none;
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    margin-right: 8px;
    vertical-align: 1px;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }
  .actions {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .theme {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 99px;
    padding: 4px 10px;
    color: #fff;
    cursor: pointer;
  }
  .theme:hover {
    border-color: #fff;
  }

  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 76px 0 28px;
    overflow: hidden;
    cursor: pointer;
  }
  .kicker span {
    color: var(--accent);
    margin: 0 6px;
  }
  #particles {
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    mix-blend-mode: difference;
  }
  #particles :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .stage {
    flex: 1;
    min-height: 260px;
  }
  .split {
    display: inline-block;
    transition: none;
  }
  .split.a {
    transform: translateX(calc(var(--p, 0) * -22vw));
  }
  .split.b {
    transform: translateX(calc(var(--p, 0) * 22vw));
  }
  .meta,
  .kicker {
    opacity: calc(1 - var(--p, 0) * 1.4);
  }
  h1 {
    font-size: clamp(52px, 10.5vw, 176px);
    text-align: center;
    margin-top: -0.35em;
    position: relative;
    pointer-events: none;
    padding: 0 16px;
  }
  .meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--fg);
  }
  .lede {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.45;
  }
  .lede em,
  footer em {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15em;
    font-weight: 400;
  }
  .cta {
    background: var(--accent);
    color: #fff;
    border-radius: 99px;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .cta:hover {
    transform: translateY(-2px);
  }
  .hint {
    position: absolute;
    right: 16px;
    top: 50%;
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  footer {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-top: 140px;
    padding-bottom: 40px;
    background: var(--fg);
    color: var(--bg);
    border-radius: 36px 36px 0 0;
    --muted: color-mix(in srgb, var(--bg) 60%, var(--fg));
    --line: color-mix(in srgb, var(--bg) 22%, var(--fg));
  }
  footer .wrap {
    width: 100%;
  }
  footer h2 {
    font-size: clamp(48px, 8vw, 120px);
    margin: 16px 0 16px;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .line > * {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .line + .line > * {
    transition-delay: 0.12s;
  }
  .in .line > * {
    transform: none;
  }
  footer h2 em {
    color: var(--accent);
  }
  footer h2 em {
    text-transform: none;
    font-size: 1.05em;
  }
  .creed {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 48px;
  }
  .email {
    font: 600 clamp(22px, 4vw, 40px) var(--display);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    word-break: break-all;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 40px;
    font-size: 18px;
  }
  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .links a:hover {
    border-color: var(--accent);
  }
  .links .cta {
    font: 800 20px var(--display);
    text-transform: uppercase;
    padding: 12px 24px;
    border: 0;
  }
  .copy {
    margin-top: 96px;
  }

  @media (prefers-reduced-motion: reduce) {
    .line > * {
      transform: none;
    }
    .split.a,
    .split.b {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    footer {
      padding-top: 42svh;
    }
    .clock,
    .hint,
    .more {
      display: none;
    }
    h1 {
      font-size: clamp(44px, 15vw, 88px);
      line-height: 0.9;
    }
    .meta {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
