---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${cv.name} — ${cv.title}`} description={cv.intro}>
  <header class="wrap top">
    <div>
      <strong>{cv.name}</strong>
      <span class="label">{cv.title}, {cv.location}</span>
    </div>
    <span class="label clock" id="clock">Prague --:--:--</span>
    <a href="#contact" class="label">Contact</a>
  </header>

  <main>
    <section class="hero wrap">
      <div id="hero-canvas" aria-hidden="true"><span class="label drag">Drag</span></div>
      <div class="hero-copy">
        <p class="label"><span class="accent">●</span> Swim · Bike · Run · Ship</p>
        <h1>Built for the<br /><span class="accent">long</span> distance.</h1>
        <p class="intro">{cv.intro}</p>
      </div>
    </section>

    <section class="wrap" id="experience">
      <div class="split"><b>01</b><h2>Experience</h2></div>
      {
        cv.experience.map((job) => (
          <article class="job">
            <div class="job-meta">
              <h3>{job.company}</h3>
              <p>{job.role}</p>
              <p class="label">{job.period}</p>
              <p class="label">{job.type}</p>
            </div>
            <ul>
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
      <p class="note">{cv.projectsNote}</p>
    </section>

    <section class="wrap" id="skills">
      <div class="split"><b>02</b><h2>Skills</h2></div>
      <div class="skills">
        {
          cv.skills.map((s) => (
            <div>
              <p class="label">{s.group}</p>
              <ul class="chips">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap" id="education">
      <div class="split"><b>03</b><h2>Education</h2></div>
      {
        cv.education.map((e) => (
          <div class="edu">
            <div>
              <h3>{e.school}</h3>
              <p>{e.degree}</p>
            </div>
            <p class="label">{e.period}</p>
          </div>
        ))
      }
    </section>

    <section class="wrap" id="off">
      <div class="split"><b>04</b><h2>Off the clock</h2></div>
      <p class="big">{cv.interests}</p>
      <p class="label langs">{cv.languages.join(' · ')}</p>
    </section>
  </main>

  <footer class="wrap" id="contact">
    <div class="split"><b>FIN</b><h2>Get in <span class="accent">contact</span></h2></div>
    <ul class="contact">
      <li><a href={`mailto:${cv.email}`}>{cv.email}</a></li>
      {
        cv.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          </li>
        ))
      }
      <li><a href={`${base}cv.pdf`} download class="cta">Download CV ↓</a></li>
    </ul>
    <p class="label copy">© {new Date().getFullYear()} {cv.name}</p>
  </footer>
</Base>

<script>
  const el = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Prague',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
  const tick = () => (el.textContent = `Prague ${fmt.format(new Date())}`);
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
    position: relative;
    z-index: 2;
  }
  .top div {
    display: flex;
    flex-direction: column;
  }
  .top strong {
    font: 800 20px var(--display);
    text-transform: uppercase;
  }
  .top a {
    text-decoration: none;
    color: var(--fg);
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }

  .hero {
    position: relative;
    min-height: min(88vh, 820px);
    display: flex;
    align-items: flex-end;
    padding-top: 0;
  }
  #hero-canvas {
    position: absolute;
    inset: 0 0 0 35%;
    cursor: grab;
    touch-action: pan-y;
  }
  #hero-canvas:active {
    cursor: grabbing;
  }
  #hero-canvas :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .drag {
    position: absolute;
    right: 16px;
    bottom: 16px;
    border: 1px solid var(--line);
    padding: 4px 10px;
    border-radius: 99px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    pointer-events: none;
    max-width: 760px;
  }
  .hero h1 {
    font-size: clamp(64px, 12vw, 180px);
    margin: 16px 0 24px;
  }
  .intro {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--muted);
    max-width: 560px;
  }

  .job {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  .job h3 {
    font-size: 36px;
  }
  .job-meta p:first-of-type {
    margin: 8px 0 12px;
    font-weight: 600;
  }
  .job ul {
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .job li {
    padding-left: 24px;
    position: relative;
  }
  .job li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 12px;
    height: 2px;
    background: var(--accent);
  }
  .note {
    margin-top: 32px;
    color: var(--muted);
    font-style: italic;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .chips li {
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 14px;
    transition: border-color 0.2s, color 0.2s;
  }
  .chips li:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .edu {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .edu h3 {
    font-size: 28px;
  }
  .edu p:not(.label) {
    color: var(--muted);
  }

  .big {
    font: 600 clamp(28px, 4vw, 44px) / 1.15 var(--display);
    text-transform: uppercase;
    max-width: 900px;
  }
  .langs {
    margin-top: 24px;
  }

  footer {
    padding: 72px 16px 40px;
  }
  .contact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    font-size: 18px;
  }
  .contact a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .contact a:hover {
    border-color: var(--accent);
  }
  .cta {
    color: var(--accent);
  }
  .copy {
    margin-top: 72px;
  }

  @media (max-width: 767px) {
    .clock {
      display: none;
    }
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
    }
    #hero-canvas {
      position: relative;
      inset: auto;
      height: 80vw;
      order: -1;
    }
    .job {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .edu {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
